# FlowPilot AI — Production Environment Variables Reference

# Environment
ENVIRONMENT=production

# Database (PostgreSQL with pgvector for production, SQLite for local zero-daemon dev)
DATABASE_URL=postgresql+psycopg://flowpilot:flowpilot_secret@localhost:5432/flowpilot
# DATABASE_URL=sqlite:///./flowpilot.db

# Task Queue / Caching
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Provider ("mock", "openai", "gemini", "anthropic")
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
